{
  "name": "chatscream",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "migrate:users": "node scripts/migrate-users-to-postgres.mjs",
    "test": "vitest",
    "test:full": "npm run lint && npm run typecheck && npm run test -- --run && npm run build && npm run test:e2e",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:full": "playwright test",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "db:push": "drizzle-kit push",
    "service:setup": "sudo bash scripts/setup-autostart.sh",
    "service:start": "sudo systemctl start chatscream",
    "service:stop": "sudo systemctl stop chatscream",
    "service:restart": "sudo systemctl restart chatscream",
    "service:logs": "journalctl -u chatscream -f",
    "service:status": "systemctl status chatscream"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@google/genai": "^1.30.0",
    "@neondatabase/serverless": "^1.0.2",
    "@openai/codex": "^0.72.0",
    "@types/multer": "^2.1.0",
    "aws": "^0.0.3-2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.555.0",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "stripe": "^21.0.1",
    "ws": "^8.19.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@typescript-eslint/utils": "^8.18.2",
    "@typescript-eslint/visitor-keys": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
