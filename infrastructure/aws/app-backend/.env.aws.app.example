# Copy to .env.aws.app (in this same directory) and customize for your AWS
# account. This configures deploy-app-backend.sh, which provisions ONE EC2
# instance for the actual ChatScream app backend (auth, OAuth, RTMP relay).
#
# This is separate from infrastructure/aws/.env.aws, which configures the
# unrelated autoscaling FFmpeg *worker fleet* for the future Cloud Streaming
# feature — you don't need that to make YouTube/Facebook streaming work.

AWS_REGION=us-east-1
VPC_ID=vpc-xxxxxxxx
SUBNET_ID=subnet-aaaaaaa

# Existing EC2 key pair name (Console → EC2 → Key Pairs) so you can SSH in.
KEY_NAME=your-key-pair-name

INSTANCE_TYPE=t3.small
INSTANCE_NAME=chatscream-app-backend
SECURITY_GROUP_NAME=chatscream-app-backend-sg

# Optional — leave blank unless this instance needs an IAM role (e.g. S3 access).
INSTANCE_PROFILE_NAME=
