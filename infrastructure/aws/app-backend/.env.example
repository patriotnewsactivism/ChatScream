# =============================================================================
# ChatScream app backend — production environment
# =============================================================================
# Copy to `.env` in this same directory on the EC2 instance and fill in real
# values. Never commit the real `.env` to version control.
#
# This file is read TWICE by design:
#   1. docker-compose.prod.yml substitutes ${DOMAIN} / ${POSTGRES_PASSWORD}
#      into the compose file itself (Compose auto-loads .env from its own dir).
#   2. `env_file: .env` on the `app` service passes everything else straight
#      into the Node process (server/index.js reads these via process.env).
# =============================================================================

# -----------------------------------------------------------------------------
# Domain — used by Caddy to request a Let's Encrypt certificate, and must
# match what you point your DNS A record at.
# -----------------------------------------------------------------------------
DOMAIN=api.yourdomain.com

# -----------------------------------------------------------------------------
# Managed identity storage — Postgres + Redis run as sibling containers in
# this same docker-compose stack (see docker-compose.prod.yml). Pick a real
# password; it's used by both the postgres container and this connection string.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_URL=postgres://chatscream:change-me-to-a-real-password@postgres:5432/chatscream
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# OAuth — required for YouTube/Facebook/Twitch "Connect" to work at all.
# Create real apps first: see ADMIN_OAUTH_SETUP_GUIDE.md at the repo root.
# The redirect URI registered in each platform's app console MUST exactly
# match VITE_OAUTH_REDIRECT_URI below (your frontend's /oauth/callback).
# -----------------------------------------------------------------------------
VITE_OAUTH_REDIRECT_URI=https://www.yourdomain.com/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Any random string — used for OAuth CSRF state signing.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_STATE_SECRET=

# This backend's own public URL (this EC2 instance's domain, i.e. https://$DOMAIN).
APP_BASE_URL=https://api.yourdomain.com

# Frontend origins allowed to call this API — your Vercel domain(s).
CORS_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# -----------------------------------------------------------------------------
# Optional — only needed if you use these features.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLAUDE_API_KEY=
GEMINI_API_KEY=
