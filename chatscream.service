[Unit]
Description=ChatScream API + WebSocket Server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/ChatScream
EnvironmentFile=-/home/user/ChatScream/.env.production
ExecStart=/opt/node22/bin/node server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chatscream

[Install]
WantedBy=multi-user.target
