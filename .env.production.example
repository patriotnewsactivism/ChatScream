# =============================================================================
# ChatScream Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in your actual production values
# NEVER commit .env.production to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration (Production)
# -----------------------------------------------------------------------------
# Leave blank when frontend and API are deployed in the same Vercel project.
# Set this only for split deployments (example: https://api.yourdomain.com).
VITE_API_BASE_URL=
# Optional override for AI endpoints if they are hosted separately
VITE_FUNCTIONS_BASE_URL=

# -----------------------------------------------------------------------------
# Managed Identity Storage (Production)
# -----------------------------------------------------------------------------
# Required for durable multi-instance auth:
# - Postgres stores users/profiles
# - Redis stores session tokens
POSTGRES_URL=
POSTGRES_SSL=true
REDIS_URL=
REDIS_TLS=true

# =============================================================================
# 🔑 OAUTH STREAMING CREDENTIALS (REQUIRED FOR YOUTUBE/FACEBOOK/TWITCH)
# =============================================================================
# Both PUBLIC IDs and BACKEND SECRETS are required for OAuth streaming to work.
# Public IDs are needed to start OAuth flows; secrets to exchange tokens.
# =============================================================================

# ── Google/YouTube OAuth (for YouTube streaming) ───────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID → Web Application
# Production redirect URI must include exactly:
# https://api.chatscream.live/api/auth/oauth/google/callback
VITE_OAUTH_REDIRECT_URI=https://api.chatscream.live/api/auth/oauth/google/callback
# Vite needs the public YouTube client ID at build time for the destination OAuth flow.
# Use the full *.apps.googleusercontent.com value; never truncate the suffix.
VITE_YOUTUBE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Facebook OAuth (for Facebook Live streaming) ───────────────────────────
# Get from: https://developers.facebook.com/apps/
# Facebook Login → Settings → Valid OAuth Redirect URIs
# Must include: https://www.chatscream.live/oauth/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0

# ── Twitch OAuth (for Twitch streaming) ───────────────────────────────────
# Get from: https://dev.twitch.tv/console/apps
# OAuth Redirect URL must include: https://www.chatscream.live/oauth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── TikTok OAuth (for TikTok LIVE streaming) ───────────────────────────────
# Requires: live.room.manage scope (TikTok LIVE partner access)
# Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Auth State Secret (required for OAuth CSRF protection) ──────────────────
AUTH_STATE_SECRET=

# ── App Base URL (for OAuth redirects) ────────────────────────────────────
# Canonical frontend origin used for redirects:
APP_BASE_URL=https://www.chatscream.live

# ── CORS Origins (allowed frontend origins) ─────────────────────────────────
CORS_ORIGINS=https://www.chatscream.live,https://chatscream.live

# ── Cloud Run backend (set in Vercel) ───────────────────────────────────────
# Uncomment and set this in Vercel if you need explicit API URL:
VITE_API_BASE_URL=https://api.chatscream.live

# -----------------------------------------------------------------------------
# Stripe Configuration (PRODUCTION - LIVE MODE)
# Get from: https://dashboard.stripe.com/apikeys (toggle to LIVE mode)
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_
VITE_STRIPE_PRO_PRICE_ID=price_
VITE_STRIPE_EXPERT_PRICE_ID=price_
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_

# -----------------------------------------------------------------------------
# AI Configuration (Production)
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (Production)
# Get from: https://sentry.io
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
VITE_APP_ENV=production
VITE_DEBUG=false
VITE_APP_VERSION=1.1.0
