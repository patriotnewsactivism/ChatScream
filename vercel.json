{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/recordings",
      "destination": "/api/recordings"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/all?path=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/all"
    },
    {
      "source": "/((?!api|assets|sw.js|manifest.json|favicon|icons).*)",
      "destination": "/index.html"
    }
  ]
}
