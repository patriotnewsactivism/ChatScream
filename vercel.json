{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "chatscream.live"
        }
      ],
      "destination": "https://www.chatscream.live/:path*",
      "permanent": true
    },
    {
      "source": "/api/auth/oauth/:path*",
      "destination": "https://api.chatscream.live/api/auth/oauth/:path*",
      "permanent": false
    },
    {
      "source": "/api/auth/social/:path*",
      "destination": "https://api.chatscream.live/api/auth/social/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/all?path=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/all"
    },
    {
      "source": "/((?!api|assets|sw.js|manifest.json|favicon|icons).*)",
      "destination": "/index.html"
    }
  ]
}
