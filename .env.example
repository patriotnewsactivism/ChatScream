# =============================================================================
# ChatScream Environment Configuration
# Copyright 2025. Based out of Houston TX.
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# 🔑 OAUTH STREAMING CREDENTIALS (REQUIRED FOR YOUTUBE/FACEBOOK/TWITCH)
# =============================================================================
# Both PUBLIC IDs and BACKEND SECRETS are required for OAuth streaming to work.
# Public IDs are needed to start OAuth flows; secrets to exchange tokens.
# =============================================================================

# ── Google/YouTube OAuth (for YouTube streaming) ───────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID → Web Application
# Redirect URI must include: http://localhost:5173/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Facebook OAuth (for Facebook Live streaming) ───────────────────────────
# Get from: https://developers.facebook.com/apps/
# Facebook Login → Settings → Valid OAuth Redirect URIs
# Must include: http://localhost:5173/oauth/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0

# ── Twitch OAuth (for Twitch streaming) ─────────────────────────────────────
# Get from: https://dev.twitch.tv/console/apps
# OAuth Redirect URL must include: http://localhost:5173/oauth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── TikTok OAuth (for TikTok Live streaming) ─────────────────────────────────
# Get from: https://developers.tiktok.com/
# Redirect URI must include: http://localhost:5173/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── OAuth Redirect Configuration ─────────────────────────────────────────────
# Read by server/app.js only, despite the VITE_ prefix — set it on the API
# host, not on the frontend deployment. It is the frontend page the backend
# redirects to after OAuth, so it needs the /oauth/callback path, not a bare
# origin (e.g. https://www.chatscream.live/oauth/callback).
# For local dev, leave empty to auto-detect from window.location.origin
VITE_OAUTH_REDIRECT_URI=
APP_BASE_URL=
AUTH_REDIRECT_URL=

# ── Auth State Secret (required for OAuth CSRF protection) ───────────────────
# Used to sign OAuth state parameters. Can be any random string.
AUTH_STATE_SECRET=

# =============================================================================
# CORS Configuration (for same-origin deployments)
# =============================================================================
# For local dev, these are auto-detected. In production, set explicitly.
CORS_ORIGINS=

# =============================================================================
# AWS Infrastructure Configuration
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_VPC_ID=
AWS_SUBNET_IDS=
AWS_STREAM_ASG_NAME=chatscream-ffmpeg-asg
AWS_STREAM_LAUNCH_TEMPLATE=chatscream-ffmpeg-lt

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# Base URL for your backend API.
# Leave blank when frontend and API are deployed together (same origin).
VITE_API_BASE_URL=
# Optional override for AI function routes when hosted separately
VITE_FUNCTIONS_BASE_URL=

# Optional Vite dev proxy target
VITE_API_PROXY_TARGET=http://localhost:8787

# -----------------------------------------------------------------------------
# Managed Identity Storage (Backend)
# -----------------------------------------------------------------------------
# Managed mode is the default and recommended mode for all non-local environments.
# Set to `local` only for explicit local-only development.
IDENTITY_STORAGE_MODE=managed

# Required when IDENTITY_STORAGE_MODE=managed:
# - Users + profiles: Postgres
# - Sessions: Redis
POSTGRES_URL=
POSTGRES_SSL=false
REDIS_URL=
REDIS_TLS=true


# -----------------------------------------------------------------------------
# Stripe Configuration (Payments & Subscriptions)
# Get these from: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------

# Publishable Key (safe to expose in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Price IDs for subscription plans
# Create these in Stripe Dashboard > Products
VITE_STRIPE_PRO_PRICE_ID=price_pro_monthly
VITE_STRIPE_EXPERT_PRICE_ID=price_expert_monthly
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# Stripe Backend Configuration (secrets)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# -----------------------------------------------------------------------------
# AI Configuration
# -----------------------------------------------------------------------------

# Claude AI (Anthropic) - Primary AI Provider
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=
VITE_CLAUDE_API_KEY=

# Google Gemini (Legacy/Backup)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Sentry (Optional)
# Get from: https://sentry.io
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# S3-Compatible Media Storage (Optional but recommended for production)
# Without this, uploads use local filesystem (lost on deploy/restart).
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, etc.
# -----------------------------------------------------------------------------
# S3_BUCKET=chatscream-media
# S3_REGION=us-east-1
# S3_ENDPOINT=                          # Required for R2/Spaces (e.g. https://xxx.r2.cloudflarestorage.com)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=                         # Public URL prefix for serving files (optional)

# -----------------------------------------------------------------------------
# Media Server Configuration (VM)
# These are populated after running infrastructure/aws/deploy-stream-fleet.sh
# -----------------------------------------------------------------------------
# RTMP_SERVER_URL=rtmp://your-vm-ip:1935/live
# HLS_SERVER_URL=http://your-vm-ip/hls

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------
VITE_APP_ENV=development
# VITE_APP_ENV=production

# Enable debug logging	
VITE_DEBUG=true

# -----------------------------------------------------------------------------
# Testing Configuration
# -----------------------------------------------------------------------------
# Use Stripe test mode
VITE_STRIPE_TEST_MODE=true

# Claude
ANTHROPIC_API_KEY=your_anthropic_api_key
# OR
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
